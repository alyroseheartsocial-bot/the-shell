# Copy this file to ".env" for local runs, or set the same names in your
# hosting dashboard (for example Render). NEVER commit a filled-in .env
# file or paste real keys into chat, issues, or screenshots.

# REQUIRED (default mode): your own Google Gemini API key (free tier is fine).
# Get one at https://aistudio.google.com/apikey
# If you use the BYOAPI mode below instead, a Gemini key is OPTIONAL — but
# voice features (live calls, read-aloud, transcription) still need one.
GEMINI_API_KEY=

# OPTIONAL — BYOAPI: run the TEXT brain on a non-Google provider instead.
# Leave AI_PROVIDER unset (or "gemini") and everything works exactly as
# before. Set it to "openai-compatible" to use any provider that speaks
# the OpenAI /chat/completions API — OpenAI, Groq, OpenRouter, Mistral,
# Together, or a local Ollama / LM Studio server. Keys belong ONLY here /
# in your host dashboard, never in the app.
#AI_PROVIDER=openai-compatible
#AI_API_KEY=
# Base URL of the provider (default https://api.openai.com/v1).
# Examples: Groq https://api.groq.com/openai/v1 ·
# OpenRouter https://openrouter.ai/api/v1 ·
# Mistral https://api.mistral.ai/v1 · Together https://api.together.xyz/v1 ·
# Local Ollama http://localhost:11434/v1
#AI_BASE_URL=https://api.openai.com/v1
# REQUIRED in openai-compatible mode: a model that provider offers,
# e.g. llama-3.3-70b-versatile (Groq) or openai/gpt-4o-mini (OpenRouter).
#AI_MODEL=

# The public URL where this app is hosted (used for links/callbacks).
APP_URL=

# OPTIONAL but recommended: a password lock for the whole app.
# When set, visitors must type this password once before they can use
# chat / voice / image tools. Leave empty and the lock stays OFF.
APP_ACCESS_PASSWORD=

# OPTIONAL FALLBACK: the name your companion goes by before anyone
# personalizes the app. The owner sets the real name (and personality)
# in the app under Profile -> Your Companion; that in-app value wins.
COMPANION_NAME=Companion

# OPTIONAL: Cloudflare Workers AI, used as the first-choice image
# generator in the Image Studio. Without these, image generation falls
# back to a free public generator and then to a simple SVG placeholder.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OPTIONAL: port for the local server (default 3000).
PORT=3000
